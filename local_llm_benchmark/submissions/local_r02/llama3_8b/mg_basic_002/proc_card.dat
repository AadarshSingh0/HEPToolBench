# Particle physics process card for MadGraph
#
# Inclusive top-pair production at 13 TeV pp collision
#

define p = g u c d s t b H W Z a h
define ~t = T~1,2
define tt~ = T~1,2*T~1,2~*~1

proc vertex ff 2 -> 2
[0,3] [1,4]
p p > tt~
{
  BEAM_P1 = (6500. , 0.) ; P1 = 6500.
  BEAM_P2 = (6500. , 0.) ; P2 = 6500.
}
```
