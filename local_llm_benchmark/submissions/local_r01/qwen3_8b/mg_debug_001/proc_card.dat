import numpy as np
import matplotlib.pyplot as plt

# Define the parameters
total_energy = 13  # TeV
beam_energy = total_energy / 2  # TeV

# Calculate the beam energy in GeV
beam_energy_gev = beam_energy * 1000  # GeV

# Define the process
process = "p p > e+ e-"

# Define the cross-section (example values)
cross_section = 1.0  # pb

# Plot the cross-section as a function of energy
energies = np.linspace(1, 10, 100)  # TeV
cross_sections = cross_section * np.ones_like(energies)

plt.figure(figsize=(10, 6))
plt.plot(energies, cross_sections, label=f"Cross-section = {cross_section} [K
pb")
plt.xlabel("Energy (TeV)")
plt.ylabel("Cross-section (pb)")
plt.title("Cross-section as a function of energy")
plt.legend()
plt.grid(True)
plt.show()
