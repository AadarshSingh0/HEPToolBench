# proc_card.dat

# Process: p p > h j

# Particle definitions:
define p = g u c d s u~ c~ d~ s~
define j = g u c d s u~ c~ d~ s~

# Model and parameters
model sm
sm model = 2 # SM Higgs boson mass set to the PDG value

# Beam energies (13 TeV pp collisions)
ebeam1 = 6500.0
ebeam2 = 6500.0

# Process definition
p p > h j QCD=2

# Output directory
output HJ
